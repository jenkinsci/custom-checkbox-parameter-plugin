<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define"
		 xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form"
		 xmlns:i="jelly:fmt" xmlns:p="/lib/hudson/project">
	<st:adjunct includes="com.bluersw.CheckboxParameter"/>
	<j:set var="escapeEntryTitleAndDescription" value="false"/>
	<f:entry title="${h.escape(it.name)}" description="${it.formattedDescription}">
		<div name="parameter" id="${it.divId}" class="custom-checkbox-parameter" style="white-space:nowrap"
			 data-checkbox-url="${h.getCurrentDescriptorByNameUrl()}/${it.descriptor.descriptorUrl}/fillCheckboxItems"
			 data-parameter-name="${it.name}">
			<input type="hidden" name="name" value="${it.name}"/>
			<label style='padding:0 0 0 10px'><input type="checkbox" name="all_checkbox" value="checkall" class="checkbox-all"/>${%parameter.selectAll} </label>
			<br/>
			<div class="checkbox-items" style="width:80%;word-wrap:break-word;word-break:break-all;"/>
			<div class="checkbox-result-message"/>
		</div>
	</f:entry>
</j:jelly>
